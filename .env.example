# =============================================================================
# AccessAudit — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs des abonnements Stripe
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# --- Resend (emails transactionnels) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Scanner service (Railway microservice) ---
# En local : laisser vide → Playwright tourne directement dans Next.js
# En production (Vercel) : mettre l'URL publique du service Railway
SCANNER_URL=https://your-scanner-service.up.railway.app
WORKER_SECRET_KEY=changeme-use-a-long-random-string
